import Either from "Either"
import File from "File"
import Path from "FilePath"
import Fn from "Function"
import Json from "Json"
import List from "List"
import Maybe from "Maybe"
import { Just } from "Maybe"
import Wish from "Wish"

import Ensign from "ensign"
import Declaration from "ensign/Declared"
import Declared from "ensign/Declared/Flags"
import EPrint from "ensign/Declared/Print"
import Flags from "ensign/Flags"
import MadlibJson from "mad-at-json/MadlibDotJson"
import Version from "mad-at-json/Version"
import VersionLock from "mad-at-json/VersionDotLock"
import Shroud from "shroud"

import Log from "@/Log"



export FLAGS = [
  Declared.flagBoolean("help", ["h"], "This text you're reading!"),
  Declared.flagBoolean("color", ["K"], "Control whether color is active"),
  Declared.flagString(
    "set-version",
    ["version", "V"],
    "The version you want to set your madlib.json to (required)",
  ),
  Declared.flagString("cwd", ["c"], "Set the current working directory"),
  Declared.flagString("madlib", ["m"], "Set the madlib.json path"),
  Declared.flagString("version-lock", ["L"], "Set the version.lock path"),
  Declared.flagBoolean("dry-run", ["D"], "Skip doing anything, just show what would happen"),
]
alias LocksmithState = {
  cwd :: String,
  dryRunOnly :: Boolean,
  madlibDotJson :: String,
  setVersion :: Maybe.Maybe String,
  showHelp :: Boolean,
  useColor :: Boolean,
  versionDotLock :: String,
}
DEFAULT_STATE :: LocksmithState
export DEFAULT_STATE = {
  useColor: true,
  cwd: ".",
  madlibDotJson: "./madlib.json",
  versionDotLock: "./version.lock",
  showHelp: false,
  setVersion: Maybe.Nothing,
  dryRunOnly: false,
}
processFlagState :: LocksmithState
  -> (LocksmithState -> Flags.Flag -> #[Boolean, LocksmithState])
  -> List Flags.Flag
  -> LocksmithState
processFlagState = (state, process, flags) => {
  walker = (done, aggState, toProcess) => if (done) {
    aggState
  } else {
    where(toProcess) {
      [] =>
        aggState

      [a, ...z] =>
        where(process(aggState, a)) {
          #[stop, upState] =>
            walker(stop, upState, z)
        }
    }
  }
  return walker(false, state, flags)
}
parseArgs = pipe(
  Flags.parseFlags,
  Declaration.validate(FLAGS),
  Either.mapLeft(EPrint.printIssues),
)
captureTheFlag :: LocksmithState -> Flags.Flag -> #[Boolean, LocksmithState]
captureTheFlag = (state, flag) => where(flag) {
  Flags.Flag(k, v) =>
    if (k == "cwd") {
      #[false, { ...state, cwd: v }]
    } else if (k == "madlib-dot-json") {
      #[false, { ...state, madlibDotJson: v }]
    } else if (k == "version-dot-lock") {
      #[false, { ...state, versionDotLock: v }]
    } else if (k == "set-version") {
      #[false, { ...state, setVersion: Maybe.Just(v) }]
    } else {
      #[false, state]
    }

  Flags.FlagToggle(k, v) =>
    if (k == "help") {
      // exclusive / short-circuiting
      #[true, { ...state, showHelp: v }]
    } else if (k == "color") {
      #[false, { ...state, useColor: v }]
    } else if (k == "dry-run") {
      #[false, { ...state, dryRunOnly: v }]
    } else {
      #[false, state]
    }

  _ =>
    #[false, state]
}
renderHelp = (useColor, flags) => {
  fn = (useColor ? EPrint.printLegendWithColor : EPrint.printLegend)
  return "locksmith\nthe feature flag that madlib package should have\n\n" ++ fn(flags)
}
rel = (cwd, x) => pipe(
  List.append($, [cwd]),
  Path.joinPath,
)(x)
hashDir = pipe(
  List.append($, ["package", "generate-hash", "-i"]),
  Shroud.cover("madlib"),
  map(.stdout),
  map(Log.env.locksmith("hash!")),
  Wish.mapRej(.stderr),
)
alias GreasedLock = #[MadlibJson.MadlibDotJson, VersionLock.VersionDotLock]
serialize :: LocksmithState -> GreasedLock -> Wish String GreasedLock
serialize = ({ madlibDotJson, versionDotLock, cwd }) => (filePair) => where(filePair) {
  #[madJson, versionLock] =>
    pipe(
      rel(cwd),
      File.write($, MadlibJson.write(madJson)),
      Wish.mapRej(Fn.always("Unable to write madlib.json")),
      chain(
        (_) => pipe(
          rel(cwd),
          File.write($, VersionLock.write(versionLock)),
          Wish.mapRej(Fn.always("Unable to write version.lock")),
        )(versionDotLock),
      ),
      map(Fn.always(filePair)),
    )(madlibDotJson)
}
// runLocksmith :: LocksmithState -> Wish String String
runLocksmith = (conf) => do {
  { madlibDotJson, versionDotLock, cwd, setVersion, dryRunOnly } = conf
  relative = rel(cwd)
  loadRelativeVersionLock = pipe(
    relative,
    VersionLock.load,
  )
  madlibJson <- pipe(
    relative,
    MadlibJson.load,
    map(Log.env.config("madlib.json")),
    Wish.mapRej(Fn.always("BARF?")),
  )(madlibDotJson)
  versionJson <- pipe(
    loadRelativeVersionLock,
    map(Log.env.config("version.lock")),
    Wish.chainRej(
      (_) => pipe(
        Shroud.cover("madlib"),
        Wish.mapRej(Fn.always("BARF?")),
        chain((_) => loadRelativeVersionLock(versionDotLock)),
      )(["package"]),
    ),
  )(versionDotLock)
  buildHash <- hashDir(cwd)
  Log.env.config("smetversion", setVersion)
  version :: Maybe Version
  version = pipe(
    scan,
    Log.env.config("VERSION!"),
  )(setVersion ?? "")

  return if (dryRunOnly) do {
    return Wish.good(MadlibJson.write(madlibJson))
    // Log.env.locksmith("!!!", MadlibJson.serialize(madlibJson))
    // return Wish.good("Nope, can't trick me into doing stuff!")
  } else {
    where(version) {
      Just(_v) =>
        pipe(
          map(Log.env.locksmith("warp engine")),
          map(Fn.always("Updated madlib.json and version.lock")),
          // Wish.mapRej(Fn.always("Unable to do shit")),
        )(
          serialize(
            conf,
            #[
              { ...madlibJson, version: Maybe.fromMaybe(Version.Version(0, 0, 0), version) },
              { ...versionJson, buildHash },
            ],
          ),
        )

      _ =>
        Wish.bad("Version required!")
    }
  }
}
main = (args) => {
  pipe(
    List.drop(1),
    Log.env.locksmith("args"),
    parseArgs,
    Log.env.locksmith("parsed"),
    map(processFlagState(DEFAULT_STATE, captureTheFlag)),
    Either.fromRight(DEFAULT_STATE),
    Log.env.locksmith("processed"),
    of,
    chain(
      Fn.ifElse(
        .showHelp,
        (x) => pipe(
          renderHelp(x.useColor),
          Wish.good,
        )(FLAGS),
        runLocksmith,
      ),
    ),
    map(Log.env.locksmith("hooray")),
    Wish.fulfill(
      (bad) => {
        Log.env.failure("out", bad)
      },
      (good) => {
        Log.env.success("yes", good)
      },
    ),
  )(args)
}
