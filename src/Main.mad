import IO from "IO"
import Wish from "Wish"

import MadJson from "mad-at-json"



main = () => {
  raw = ["a"]
  IO.pTrace("##", raw ++ ["x"])
  pipe(
    MadJson.load,
    map(IO.pTrace("RAW")),
    Wish.fulfill((e) => { IO.pTrace("BAD", e) }, (x) => { IO.pTrace("GOOD", x) }),
  )("madlib.json")
}
